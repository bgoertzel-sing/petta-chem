       (ssa-run
         seed $seed
         events $records
         final-counts $counts
         final-time $time-limit
         stop time-bound)
       (if (== $remaining 0)
           (ssa-run
             seed $seed
             events $records
             final-counts $counts
             final-time $time
             stop event-bound)
           (let $step
             (neutral-ssa-step
               $seed $event-index
               $food $molecules $reactions $volume $catalysis $counts)
             (let $record (neutral-ssa-step-record $step)
               (if (== $record no-enabled-event)
                   (ssa-run
                     seed $seed
                     events $records
                     final-counts $counts
                     final-time $time
                     stop no-enabled-event)
                   (let $next-time
                     (+ $time (neutral-ssa-draw-waiting-time $record))
                     (if (> $next-time $time-limit)
